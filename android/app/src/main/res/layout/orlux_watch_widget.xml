<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orlux_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.18"
        android:text="@string/orlux_widget_brand"
        android:textAllCaps="true"
        android:textColor="@color/orlux_aurora"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextClock
        android:id="@+id/digital_local"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="h:mm a"
        android:format24Hour="HH:mm"
        android:maxLines="1"
        android:textColor="@color/orlux_on_ink"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/zone_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/orlux_ice"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/utc_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/utc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/orlux_widget_utc"
            android:textColor="@color/orlux_aurora"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/digital_utc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="@color/orlux_aurora"
            android:textSize="16sp"
            android:textStyle="bold"
            android:timeZone="UTC" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/event_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/timer_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/orlux_mint"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/orlux_on_ink"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alarm_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/orlux_ice"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
